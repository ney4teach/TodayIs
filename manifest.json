{
  "manifest_version": 3,
  "name": "Today Is",
  "version": "1.0.0",
  "description": "Русскоязычная панель новой вкладки с десятью виджетами.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {"service_worker": "activity-worker.js"},
  "permissions": ["nativeMessaging", "tabs", "idle", "alarms",
    "identity",
    "storage",
    "bookmarks", "favicon",
    "system.cpu",
    "system.memory",
    "geolocation"
  ],
  "host_permissions": [
    "https://dashney4.alwaysdata.net/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://nominatim.openstreetmap.org/*"
  ]
}